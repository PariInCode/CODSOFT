<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Rule-Based Chatbot</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="chat-container">
    <div class="chat-header">🤖 Rule-Based Chatbot</div>

    <div class="chat-box" id="chat-box">
      <div class="message bot">Hello! I'm your chatbot. Type something to get started!</div>
    </div>

    <div class="chat-input">
      <input type="text" id="user-input" placeholder="Type a message..." autocomplete="off"/>
      <button onclick="sendMessage()">Send</button>
    </div>
  </div>

  <script>
async function sendMessage(){
    const message = document.getElementById('user-input');
    const msg = message.value.trim();
    if(!msg) return;
    
    appendMessage(msg, "user");
        message.value = "";
    const res = await fetch('/chatbot',{
        method:"POST",
        headers:{
            "Content-Type": "application/json"
        },
        body: JSON.stringify({ message: msg }),
    });

    const data = await res.json();
    appendMessage(data.reply,"bot")
}

function appendMessage ( message , sender){
      const box = document.getElementById("chat-box");
      const div = document.createElement("div");
      div.className = `message ${sender}`;
      div.textContent = message;
      box.appendChild(div);
      box.scrollTop = box.scrollHeight;
}
  </script>

  
  </body>
  </html>